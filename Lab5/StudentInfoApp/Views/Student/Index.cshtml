@model StudentInfoApp.ViewModels.StudentViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Information</title>
</head>
<body>
    <h1>Enter Student Information</h1>
    <form asp-action="Index" method="post">
        <div>
            <label asp-for="Name"></label>
            <input asp-for="Name" />
            <span asp-validation-for="Name" style="color:red"></span>
        </div>
        <div>
            <label asp-for="Course"></label>
            <input asp-for="Course" />
            <span asp-validation-for="Course" style="color:red"></span>
        </div>
        <div>
            <label asp-for="Semester"></label>
            <input asp-for="Semester" />
            <span asp-validation-for="Semester" style="color:red"></span>
        </div>
        <button type="submit">Submit</button>
    </form>

    @if (Model.IsValid)
    {
        <h2>Student Information:</h2>
        <p>Name: @Model.Name</p>
        <p>Course: @Model.Course</p>
        <p>Semester: @Model.Semester</p>
    }

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation/1.19.2/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.11/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
